{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "/home/olore/.config/fastfetch/ascii/13.txt",
    "color": {
      "1": "33"
    },
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " › "
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "33",
        "at": "33",
        "host": "33"
      }
    },
    {
      "type": "custom",
      "format": "──────────────────────────────"
    },
    {
      "key": "  ✝ OS",
      "keyColor": "33",
      "type": "os"
    },
    {
      "key": "  ✝ Kernel",
      "keyColor": "33",
      "type": "kernel"
    },
    {
      "key": "  ✝ Uptime",
      "keyColor": "33",
      "type": "uptime"
    },
    {
      "key": "  ✝ Shell",
      "keyColor": "33",
      "type": "shell"
    },
    {
      "key": "  ✝ WM",
      "keyColor": "33",
      "type": "wm"
    },
    {
      "key": "  ✝ Memory",
      "keyColor": "33",
      "type": "memory"
    },
    {
      "type": "custom",
      "format": "──────────────────────────────"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
